DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings.lan
SECRET_KEY=replace-with-a-long-random-secret-before-running
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=scopedeal
POSTGRES_USER=scopedeal
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://scopedeal:replace-with-local-database-password@database:5432/scopedeal
